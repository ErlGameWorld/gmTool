{erl_opts, [
	{i, "include"},
	no_debug_info,
	deterministic,
	warn_export_vars,
	warn_shadow_vars,
	warn_obsolete_guard,
	warn_untyped_record
]}.
{deps, [
	{eWSrv, ".*", {git, "https://github.com/ErlGameWorld/eWSrv.git", {branch, "main"}}}
]}.

{shell, [
    %% {config, "config/sys.config"},
    {apps, [gmTool]}
]}.

%% == Escript Configuration ==
%% 产出: _build/default/bin/gmTool
%% 其他项目只需复制该单文件 + src/utils/gmToolBootstrap.erl，
%% 启动时传入自己的 menu_module 即可。
{escript_main_app, gmTool}.
{escript_name, "gmTool"}.
{escript_incl_apps, [eWSrv, eNet]}.
{escript_emu_args, "%%! +sbtu +A0 -sname gmTool -setcookie gmTool -detached\n"}.

{provider_hooks, [
    {pre, [{escriptize, {default, compile}}]}
]}.

%% Build / embed gmCli frontend before compile & escriptize.
%% Skip with: set GMTOOL_SKIP_FRONTEND=1
{pre_hooks, [
    {compile, "node scripts/rebar_frontend_hook.mjs"},
    {escriptize, "node scripts/rebar_frontend_hook.mjs"}
]}.
